# Copy to .env.local — never commit real secrets.
# MongoDB (Better Auth stores users/sessions here)
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.example.mongodb.net/
MONGODB_DB_NAME=studiospace

# Better Auth
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Shared with the Express API (must match AUTH_JWT_SECRET in the server .env)
AUTH_JWT_SECRET=generate-a-different-long-random-string

# Express + MongoDB API (proxied in the browser through /api/server/*)
API_URL=http://localhost:5000
